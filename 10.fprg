<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="10"/>
        <attribute name="authors" value="user"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-29 07:22:37 "/>
        <attribute name="created" value="dXNlcjtIT01FLVBDOzIwMjYtMTAtMjg7IjA5OjI2OjUwICI7MjEzNA=="/>
        <attribute name="edited" value="dXNlcjtIT01FLVBDOzIwMjYtMTAtMjk7IjA3OjIyOjM3ICI7MjsyMjQz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, d" type="Integer" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <assign variable="c" expression="a"/>
            <assign variable="d" expression="0"/>
            <while expression="c&lt;=b">
                <assign variable="d" expression="d+c"/>
                <assign variable="c" expression="c+1"/>
            </while>
            <output expression="d" newline="True"/>
        </body>
    </function>
</flowgorithm>
