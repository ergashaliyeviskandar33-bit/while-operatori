    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="narx, b, c" type="Integer" array="False" size=""/>
            <input variable="narx"/>
            <assign variable="b" expression="1"/>
            <while expression="b&lt;=10">
                <assign variable="c" expression="narx*b"/>
                <output expression="b &amp;&quot; Kilogram konfet narxi &quot; &amp;c" newline="True"/>
                <assign variable="b" expression="b+1"/>
            </while>
        </body>
    </function>
</flowgorithm>
